{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FAP Attendance (Chrome - Khuyên Dùng)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "program": "lib/main.dart",
            "flutterMode": "debug"
        },
        {
            "name": "FAP Attendance (Edge)",
            "request": "launch",
            "type": "dart",
            "deviceId": "edge",
            "program": "lib/main.dart",
            "flutterMode": "debug"
        },
        {
            "name": "Mở Chrome localhost:8080 (Web Server)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}/build/web"
        }
    ]
}