{
  "manifest_version": 3,
  "name": "FAP Auto Attendance Assistant - FPT University",
  "version": "1.0.0",
  "description": "Tiện ích mở rộng hỗ trợ giảng viên FPT tự động tích điểm danh sinh viên trên FAP dựa trên dữ liệu quét mã QR & Google Sheets.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FAP Auto Attendance"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://fap.fpt.edu.vn/*",
    "http://localhost:8080/*",
    "https://script.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://fap.fpt.edu.vn/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}
